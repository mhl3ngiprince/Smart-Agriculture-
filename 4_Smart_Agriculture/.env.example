# ---- Smart Agriculture configuration ----

# --- MQTT broker (sensors publish here, commands are published back) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=farm/sensors
MQTT_CMD_TOPIC=farm/commands
MQTT_USER=
MQTT_PASS=
MQTT_TLS=false
MQTT_CLIENT_ID=smart-agri
MQTT_RECONNECT=5

# --- Storage ---
FARM_DB_PATH=farm.db
FARM_EXPORT_DIR=exports

# --- Weather (Open-Meteo, free, no key). Used to make irrigation rain-aware. ---
FARM_WEATHER=true
FARM_LAT=-26.2041
FARM_LON=28.0473
FARM_RAIN_HOURS=12
FARM_RAIN_SKIP_MM=2.0

# --- Irrigation policy ---
FARM_MOISTURE_MIN=35
FARM_MOISTURE_MAX=85
FARM_MOISTURE_TARGET=50
FARM_PUMP_MINUTES=20
FARM_IRRIG_COOLDOWN=120
# SAFETY: keep DRY_RUN=true until you have wired and tested real relays.
FARM_DRY_RUN=true

# --- Alerts ---
FARM_ALERT_WEBHOOK=
FARM_ALERT_EMAIL=
FARM_SMTP_HOST=
FARM_SMTP_PORT=587
FARM_SMTP_USER=
FARM_SMTP_PASS=

# --- API ---
FARM_API_HOST=0.0.0.0
FARM_API_PORT=8004
FARM_DEVICE_TOKEN=
